@model List<FinanceiroApp.Models.Transaction>
@{ Layout = "_Layout"; ViewData["Title"] = "Transações"; ViewData["Active"] = "transactions"; }

<div class="page-header">
    <div>
        <h1 class="page-title">Transações</h1>
        <p class="page-subtitle">@Model.Count transação(ões) encontrada(s)</p>
    </div>
    <button class="btn-primary" onclick="openModal('modal-transaction')">+ Nova transação</button>
</div>

<!-- Filtros -->
<div class="filters-bar">
    <a href="/Transactions" class="filter-btn @(ViewBag.SelectedType == null ? "active" : "")">Todas</a>
    <a href="/Transactions?type=income" class="filter-btn @(ViewBag.SelectedType == "income" ? "active" : "")">Receitas</a>
    <a href="/Transactions?type=expense" class="filter-btn @(ViewBag.SelectedType == "expense" ? "active" : "")">Despesas</a>
</div>

<!-- Tabela de transações -->
<div class="section-card">
    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Data</th>
                    <th>Tipo</th>
                    <th>Valor</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Description</td>
                        <td><span class="badge">@t.Category</span></td>
                        <td>@t.Date.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="type-badge @(t.Type == FinanceiroApp.Models.TransactionType.Income ? "type-income" : "type-expense")">
                                @(t.Type == FinanceiroApp.Models.TransactionType.Income ? "Receita" : "Despesa")
                            </span>
                        </td>
                        <td class="@(t.Type == FinanceiroApp.Models.TransactionType.Income ? "amount-green" : "amount-red") fw-600">
                            @(t.Type == FinanceiroApp.Models.TransactionType.Income ? "+" : "-")R$ @t.Amount.ToString("N2")
                        </td>
                        <td>
                            <form method="post" action="/Transactions/Delete/@t.Id" onsubmit="return confirm('Excluir esta transação?')">
                                <button type="submit" class="btn-delete">✕</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state large">
            <div class="empty-icon">⇄</div>
            <p>Nenhuma transação encontrada</p>
            <button class="btn-primary" onclick="openModal('modal-transaction')">Adicionar primeira transação</button>
        </div>
    }
</div>

<!-- Modal: Nova Transação -->
<div id="modal-transaction" class="modal-overlay" style="display:none">
    <div class="modal">
        <div class="modal-header">
            <h3>Nova Transação</h3>
            <button onclick="closeModal('modal-transaction')" class="modal-close">✕</button>
        </div>
        <form method="post" action="/Transactions/Create">
            <div class="field">
                <label>Descrição</label>
                <input type="text" name="Description" placeholder="Ex: Supermercado" required />
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Valor (R$)</label>
                    <input type="number" name="Amount" step="0.01" min="0.01" placeholder="0,00" required />
                </div>
                <div class="field">
                    <label>Data</label>
                    <input type="date" name="Date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Tipo</label>
                    <select name="Type" id="type-select" onchange="updateCategories(this.value)">
                        <option value="1">Despesa</option>
                        <option value="0">Receita</option>
                    </select>
                </div>
                <div class="field">
                    <label>Categoria</label>
                    <select name="Category" id="category-select">
                        <option>Alimentação</option><option>Moradia</option><option>Transporte</option>
                        <option>Saúde</option><option>Educação</option><option>Lazer</option>
                        <option>Roupas</option><option>Tecnologia</option><option>Outros (Despesa)</option>
                    </select>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" onclick="closeModal('modal-transaction')" class="btn-secondary">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar →</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function updateCategories(type) {
    const sel = document.getElementById('category-select');
    const income = ['Salário','Freelance','Investimentos','Outros (Receita)'];
    const expense = ['Alimentação','Moradia','Transporte','Saúde','Educação','Lazer','Roupas','Tecnologia','Outros (Despesa)'];
    const cats = type === '0' ? income : expense;
    sel.innerHTML = cats.map(c => `<option>${c}</option>`).join('');
}
</script>
}
