@model FinanceiroApp.Models.LoginViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Login"; }

<div class="auth-page">
    <div class="auth-bg">
        <div class="auth-blob b1"></div>
        <div class="auth-blob b2"></div>
        <div class="auth-blob b3"></div>
    </div>

    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">◈</div>
            <h1>Financer</h1>
            <p>Controle financeiro inteligente</p>
        </div>

        @if (Model.Error != null)
        {
            <div class="alert-error">⚠ @Model.Error</div>
        }

        <form method="post" action="/Auth/Login">
            <div class="field">
                <label>Email</label>
                <input type="email" name="Email" placeholder="seu@email.com" required />
            </div>
            <div class="field">
                <label>Senha</label>
                <input type="password" name="Password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn-primary btn-full">Entrar →</button>
        </form>

        <div class="auth-footer">
            Não tem conta? <a href="/Auth/Register">Cadastre-se</a>
        </div>
    </div>
</div>
