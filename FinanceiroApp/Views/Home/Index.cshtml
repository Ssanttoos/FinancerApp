@model FinanceiroApp.Models.DashboardViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Dashboard"; ViewData["Active"] = "dashboard"; }

<div class="page-header">
    <div>
        <h1 class="page-title">Olá, @Model.User.Name.Split(' ')[0] 👋</h1>
        <p class="page-subtitle">@DateTime.Now.ToString("MMMM yyyy") — visão geral</p>
    </div>
    <button class="btn-primary" onclick="openModal('modal-transaction')">+ Nova transação</button>
</div>

<!-- Cards de resumo -->
<div class="cards-grid">
    <div class="summary-card card-green">
        <div class="card-label">Receitas do mês</div>
        <div class="card-value">R$ @Model.TotalIncome.ToString("N2")</div>
        <div class="card-icon">↑</div>
    </div>
    <div class="summary-card card-red">
        <div class="card-label">Despesas do mês</div>
        <div class="card-value">R$ @Model.TotalExpenses.ToString("N2")</div>
        <div class="card-icon">↓</div>
    </div>
    <div class="summary-card @(Model.Balance >= 0 ? "card-blue" : "card-orange")">
        <div class="card-label">Saldo do mês</div>
        <div class="card-value">R$ @Model.Balance.ToString("N2")</div>
        <div class="card-icon">◈</div>
    </div>
</div>

<!-- Gráficos -->
<div class="charts-grid">
    <div class="chart-card">
        <h3 class="chart-title">Receitas vs Despesas (6 meses)</h3>
        <canvas id="barChart" height="200"></canvas>
    </div>
    <div class="chart-card">
        <h3 class="chart-title">Despesas por categoria</h3>
        @if (Model.ExpensesByCategory.Any())
        {
            <canvas id="pieChart" height="200"></canvas>
        }
        else
        {
            <div class="empty-chart">Nenhuma despesa este mês</div>
        }
    </div>
</div>

<!-- Transações recentes + Metas -->
<div class="bottom-grid">
    <div class="section-card">
        <div class="section-header">
            <h3>Últimas transações</h3>
            <a href="/Transactions" class="link-more">Ver todas →</a>
        </div>
        @if (Model.RecentTransactions.Any())
        {
            <div class="transactions-list">
                @foreach (var t in Model.RecentTransactions)
                {
                    <div class="transaction-row">
                        <div class="t-icon @(t.Type == FinanceiroApp.Models.TransactionType.Income ? "t-income" : "t-expense")">
                            @(t.Type == FinanceiroApp.Models.TransactionType.Income ? "↑" : "↓")
                        </div>
                        <div class="t-info">
                            <span class="t-desc">@t.Description</span>
                            <span class="t-cat">@t.Category</span>
                        </div>
                        <div class="t-amount @(t.Type == FinanceiroApp.Models.TransactionType.Income ? "amount-green" : "amount-red")">
                            @(t.Type == FinanceiroApp.Models.TransactionType.Income ? "+" : "-")R$ @t.Amount.ToString("N2")
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">Nenhuma transação ainda</div>
        }
    </div>

    <div class="section-card">
        <div class="section-header">
            <h3>Metas de economia</h3>
            <a href="/Goals" class="link-more">Ver todas →</a>
        </div>
        @if (Model.Goals.Any())
        {
            @foreach (var g in Model.Goals.Take(4))
            {
                <div class="goal-mini">
                    <div class="goal-mini-header">
                        <span>@g.Title</span>
                        <span class="goal-pct">@g.ProgressPercent.ToString("0")%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @g.ProgressPercent%"></div>
                    </div>
                    <div class="goal-mini-values">
                        <span>R$ @g.CurrentAmount.ToString("N2")</span>
                        <span>R$ @g.TargetAmount.ToString("N2")</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">Nenhuma meta criada</div>
        }
    </div>
</div>

<!-- Modal: Nova Transação -->
<div id="modal-transaction" class="modal-overlay" style="display:none">
    <div class="modal">
        <div class="modal-header">
            <h3>Nova Transação</h3>
            <button onclick="closeModal('modal-transaction')" class="modal-close">✕</button>
        </div>
        <form method="post" action="/Transactions/Create">
            <div class="field">
                <label>Descrição</label>
                <input type="text" name="Description" placeholder="Ex: Supermercado" required />
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Valor (R$)</label>
                    <input type="number" name="Amount" step="0.01" min="0.01" placeholder="0,00" required />
                </div>
                <div class="field">
                    <label>Data</label>
                    <input type="date" name="Date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Tipo</label>
                    <select name="Type" id="type-select" onchange="updateCategories(this.value)">
                        <option value="1">Despesa</option>
                        <option value="0">Receita</option>
                    </select>
                </div>
                <div class="field">
                    <label>Categoria</label>
                    <select name="Category" id="category-select">
                        <option>Alimentação</option>
                        <option>Moradia</option>
                        <option>Transporte</option>
                        <option>Saúde</option>
                        <option>Educação</option>
                        <option>Lazer</option>
                        <option>Roupas</option>
                        <option>Tecnologia</option>
                        <option>Outros (Despesa)</option>
                    </select>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" onclick="closeModal('modal-transaction')" class="btn-secondary">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar →</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
// Dados para os gráficos (passados do C# para o JavaScript)
const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyData));
const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesByCategory));

// Gráfico de barras - Receitas vs Despesas
const barCtx = document.getElementById('barChart')?.getContext('2d');
if (barCtx) {
    new Chart(barCtx, {
        type: 'bar',
        data: {
            labels: monthlyData.map(d => d.month),
            datasets: [
                {
                    label: 'Receitas',
                    data: monthlyData.map(d => d.income),
                    backgroundColor: 'rgba(34, 197, 94, 0.7)',
                    borderRadius: 6,
                },
                {
                    label: 'Despesas',
                    data: monthlyData.map(d => d.expenses),
                    backgroundColor: 'rgba(239, 68, 68, 0.7)',
                    borderRadius: 6,
                }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { labels: { color: '#94a3b8' } } },
            scales: {
                x: { ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } },
                y: { ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } }
            }
        }
    });
}

// Gráfico de pizza - Despesas por categoria
const pieCtx = document.getElementById('pieChart')?.getContext('2d');
if (pieCtx && Object.keys(categoryData).length > 0) {
    new Chart(pieCtx, {
        type: 'doughnut',
        data: {
            labels: Object.keys(categoryData),
            datasets: [{
                data: Object.values(categoryData),
                backgroundColor: ['#6366f1','#f59e0b','#10b981','#ef4444','#3b82f6','#8b5cf6','#ec4899','#14b8a6'],
                borderWidth: 0,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom', labels: { color: '#94a3b8', padding: 12 } } },
            cutout: '65%'
        }
    });
}

// Categorias dinâmicas no modal
function updateCategories(type) {
    const sel = document.getElementById('category-select');
    const income = ['Salário','Freelance','Investimentos','Outros (Receita)'];
    const expense = ['Alimentação','Moradia','Transporte','Saúde','Educação','Lazer','Roupas','Tecnologia','Outros (Despesa)'];
    const cats = type === '0' ? income : expense;
    sel.innerHTML = cats.map(c => `<option>${c}</option>`).join('');
}
</script>
}
